{
    "name": "plex-file-manager-frontend",
    "private": true,
    "version": "2.5.1",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
