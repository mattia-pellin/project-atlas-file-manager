.Python
# NOTE: these setuptools patterns are anchored with a leading slash on
# purpose. Unanchored, `lib/` and `var/` silently swallow source directories
# anywhere in the tree - `frontend/src/lib/` was invisible to git because of it.
/env/
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg
.cache/
backend/.cache/

# Node / React
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
