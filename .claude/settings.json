{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(venv/bin/python -m pytest*)",
      "Bash(venv/bin/python -m ruff*)",
      "Bash(venv/bin/python -m pip install -r requirements-dev.txt)",
      "Bash(npm run lint*)",
      "Bash(npm run typecheck*)",
      "Bash(npm test*)",
      "Bash(npm run test*)",
      "Bash(npm run build*)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git checkout test_media/*)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(docker compose config*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker ps*)",
      "Bash(docker logs*)",
      "Bash(docker images*)",
      "Bash(docker inspect*)",
      "Bash(docker version*)",
      "Read(./.env)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:developer.themoviedb.org)",
      "WebFetch(domain:thetvdb.github.io)",
      "WebFetch(domain:support.plex.tv)",
      "WebFetch(domain:stitch.withgoogle.com)"
    ],
    "deny": [
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Read(./venv/**)",
      "Read(./backend/venv/**)",
      "Read(./frontend/node_modules/**)",
      "Read(./.cache/**)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git tag*)",
      "Bash(git commit*)",
      "Bash(git reset*)",
      "Bash(git restore*)",
      "Bash(docker compose up*)",
      "Bash(docker compose down*)",
      "Bash(docker compose build*)",
      "Bash(docker build*)",
      "Bash(gh release*)",
      "Bash(gh workflow run*)",
      "Bash(npx plugins*)",
      "Bash(npx skills*)"
    ]
  },
  "enableAllProjectMcpServers": false,
  "enabledPlugins": {
    "stitch-design@google-labs-code-stitch-skills": true,
    "stitch-build@google-labs-code-stitch-skills": true,
    "stitch-utilities@google-labs-code-stitch-skills": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format-on-edit.sh",
            "args": [],
            "timeout": 60,
            "statusMessage": "Formatting edited file"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-bash.sh",
            "args": [],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
