# Copy to .env and fill in. Never commit .env.

# The library is NOT configured here. It is a mount, and its container side is fixed:
# whatever directory the app is to work on must appear at /media inside the container.
#
#   docker run  -v /srv/plex:/media:rw ...
#   compose     volumes: [ "/srv/plex:/media:rw" ]   (docker-compose.override.yml)

# Container-side root the app may read and rename inside (optional, default /media).
# A scan may narrow to a subdirectory of it and to nothing else; anything outside is
# rejected with a 400.
#
# In the container this is /media and must stay /media — docker-compose.yml sets it
# and ignores whatever is here. It is settable for one case only: running the backend
# outside Docker, where /media does not exist and every scan would return a 400.
# e.g. MEDIA_ROOT=/path/to/repo/test_media
MEDIA_ROOT=/media

# Host port the container is published on (optional, default 8080). Only the host
# side of the mapping: the app inside the container always listens on 8000.
PORT=8080

# TheMovieDb API key - required to match movies
TMDB_API_KEY=

# TheTVDB v4 API key - required to match series
TVDB_API_KEY=

# TheTVDB user PIN - optional, unlocks extended API access
TVDB_PIN=

# How long TMDB/TVDB responses stay cached on disk, in hours (optional, default 24).
# Fractions are allowed: 0.5 is thirty minutes. 0 means reuse nothing, which is what
# you want while chasing a wrong match. A value that is not a number, or is negative,
# falls back to 24 rather than taking the app down. A "nothing matched" answer is
# held for an hour at most whatever this says — it follows this value down, never up.
CACHE_TTL_HOURS=24

# Title languages, most preferred first (optional, default it,en). Only the value
# the UI starts with: language, cache and confidence thresholds are all overridable
# per request from the settings panel.
LANG_PREFS=it,en
