# Copy to .env and fill in. Never commit .env.

# Host path mounted into the container at /media (required)
MEDIA_DIR=/path/to/your/media

# Container-side root the app may read and rename inside (optional, default /media).
# A scan may narrow to a subdirectory of it and to nothing else; anything outside is
# rejected with a 400. This is the other side of the mount above: MEDIA_DIR is the
# host path, MEDIA_ROOT is where it appears inside the container. Set it explicitly
# when running the backend outside Docker, e.g. MEDIA_ROOT=/path/to/repo/test_media
MEDIA_ROOT=/media

# Host port the container is published on (optional, default 8080). Only the host
# side of the mapping: the app inside the container always listens on 8000.
PORT=8080

# TheMovieDb API key - required to match movies
TMDB_API_KEY=

# TheTVDB v4 API key - required to match series
TVDB_API_KEY=

# TheTVDB user PIN - optional, unlocks extended API access
TVDB_PIN=

# How long TMDB/TVDB responses stay cached on disk (optional, default 24)
CACHE_TTL_HOURS=24

# Title languages, most preferred first (optional, default it,en). Only the value
# the UI starts with: language, cache and confidence thresholds are all overridable
# per request from the settings panel.
LANG_PREFS=it,en
